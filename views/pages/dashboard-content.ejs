<%- include('../partials/head') %>

<div style="margin-bottom: var(--space-6);">
  <h1 style="font-size: 24px; font-weight: 700;">Dashboard Content Management</h1>
  <p class="text-muted">Manage carousels, offers, and announcements for the dashboard.</p>
</div>

<!-- Tabs -->
<div class="tabs-container" style="border-bottom: 1px solid var(--border); margin-bottom: var(--space-6); display: flex; gap: var(--space-4);">
  <button class="tab-btn active" data-tab="carousel" style="padding: 12px 16px; border: none; background: none; font-weight: 600; border-bottom: 2px solid var(--primary); color: var(--primary); cursor: pointer;">Carousel</button>
  <button class="tab-btn" data-tab="offers" style="padding: 12px 16px; border: none; background: none; font-weight: 600; border-bottom: 2px solid transparent; color: var(--text-muted); cursor: pointer;">Offers</button>
  <button class="tab-btn" data-tab="announcements" style="padding: 12px 16px; border: none; background: none; font-weight: 600; border-bottom: 2px solid transparent; color: var(--text-muted); cursor: pointer;">Announcements</button>
</div>

<!-- CAROUSEL TAB -->
<div id="tab-carousel" class="tab-content active">
  <div style="display: flex; justify-content: space-between; margin-bottom: var(--space-4);">
    <h2 style="font-size: 18px; font-weight: 600;">Hero Carousel</h2>
    <button class="btn btn-primary" onclick="openModal('carouselModal')"><i data-lucide="plus"></i> Add Carousel</button>
  </div>
  <div class="card">
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Image</th>
            <th>Title</th>
            <th>Status</th>
            <th>Priority</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="carousel-list">
          <tr><td colspan="5" class="text-center text-muted">Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- OFFERS TAB -->
<div id="tab-offers" class="tab-content" style="display: none;">
  <div style="display: flex; justify-content: space-between; margin-bottom: var(--space-4);">
    <h2 style="font-size: 18px; font-weight: 600;">Special Offers</h2>
    <button class="btn btn-primary" onclick="openModal('offerModal')"><i data-lucide="plus"></i> Add Offer</button>
  </div>
  <div class="card">
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Offer Title</th>
            <th>Type</th>
            <th>Status</th>
            <th>Valid Until</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="offers-list">
          <tr><td colspan="5" class="text-center text-muted">Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- ANNOUNCEMENTS TAB -->
<div id="tab-announcements" class="tab-content" style="display: none;">
  <div style="display: flex; justify-content: space-between; margin-bottom: var(--space-4);">
    <h2 style="font-size: 18px; font-weight: 600;">Popups & Announcements</h2>
    <button class="btn btn-primary" onclick="openModal('announcementModal')"><i data-lucide="plus"></i> Add Announcement</button>
  </div>
  <div class="card">
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Type</th>
            <th>Target</th>
            <th>Frequency</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="announcements-list">
          <tr><td colspan="6" class="text-center text-muted">Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- MODALS -->

<!-- Carousel Modal -->
<div id="carouselModal" class="modal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000;">
  <div class="card" style="width: 90%; max-width: 600px; max-height: 90vh; overflow-y: auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 16px; margin-bottom: 16px;">
      <h3 style="font-size: 18px; font-weight: 600;">Carousel Item</h3>
      <button onclick="closeModal('carouselModal')" style="background: none; border: none; cursor: pointer;"><i data-lucide="x"></i></button>
    </div>
    <form id="carouselForm" onsubmit="handleFormSubmit(event, 'carousel')">
      <input type="hidden" id="carouselId" name="id">
      <div class="form-group mb-3">
        <label>Title</label>
        <input type="text" name="title" class="form-control" required>
      </div>
      <div class="form-group mb-3">
        <label>Description</label>
        <textarea name="description" class="form-control" rows="2"></textarea>
      </div>
      <div class="form-group mb-3">
        <label>Image URL (Required)</label>
        <input type="url" name="image" class="form-control" required>
      </div>
      <div class="responsive-grid-2 mb-3">
        <div class="form-group">
          <label>Type</label>
          <select name="type" class="form-control" required>
            <option value="FEATURED">Featured</option>
            <option value="NEW">New</option>
            <option value="PROMOTION">Promotion</option>
            <option value="OFFER">Offer</option>
          </select>
        </div>
        <div class="form-group">
          <label>Status</label>
          <select name="isActive" class="form-control">
            <option value="true">Active</option>
            <option value="false">Inactive</option>
          </select>
        </div>
      </div>
      <div class="responsive-grid-2 mb-3">
        <div class="form-group">
          <label>CTA Text</label>
          <input type="text" name="ctaText" class="form-control">
        </div>
        <div class="form-group">
          <label>CTA URL</label>
          <input type="text" name="ctaUrl" class="form-control">
        </div>
      </div>
      <div style="display: flex; justify-content: flex-end; gap: 12px;">
        <button type="button" class="btn btn-secondary" onclick="closeModal('carouselModal')">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Carousel</button>
      </div>
    </form>
  </div>
</div>

<!-- Offer Modal -->
<div id="offerModal" class="modal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000;">
  <div class="card" style="width: 90%; max-width: 600px; max-height: 90vh; overflow-y: auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 16px; margin-bottom: 16px;">
      <h3 style="font-size: 18px; font-weight: 600;">Offer Item</h3>
      <button onclick="closeModal('offerModal')" style="background: none; border: none; cursor: pointer;"><i data-lucide="x"></i></button>
    </div>
    <form id="offerForm" onsubmit="handleFormSubmit(event, 'offers')">
      <input type="hidden" id="offerId" name="id">
      <div class="form-group mb-3">
        <label>Offer Title</label>
        <input type="text" name="title" class="form-control" required>
      </div>
      <div class="responsive-grid-2 mb-3">
        <div class="form-group">
          <label>Offer Type</label>
          <select name="offerType" class="form-control" required>
            <option value="PROJECT">Project Offer</option>
            <option value="BOOKING">Booking Offer</option>
            <option value="COMMISSION">Commission Bonus</option>
            <option value="FESTIVAL">Festival Offer</option>
          </select>
        </div>
        <div class="form-group">
          <label>Status</label>
          <select name="isActive" class="form-control">
            <option value="true">Active</option>
            <option value="false">Inactive</option>
          </select>
        </div>
      </div>
      <div class="responsive-grid-2 mb-3">
        <div class="form-group">
          <label>Discount Value</label>
          <input type="text" name="discount" class="form-control" placeholder="e.g. ₹50,000 OFF">
        </div>
        <div class="form-group">
          <label>Commission Bonus</label>
          <input type="text" name="commissionBonus" class="form-control" placeholder="e.g. Extra 1%">
        </div>
      </div>
      <div class="form-group mb-3">
        <label>Terms & Conditions</label>
        <textarea name="terms" class="form-control" rows="2"></textarea>
      </div>
      <div style="display: flex; justify-content: flex-end; gap: 12px;">
        <button type="button" class="btn btn-secondary" onclick="closeModal('offerModal')">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Offer</button>
      </div>
    </form>
  </div>
</div>

<!-- Announcement Modal -->
<div id="announcementModal" class="modal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000;">
  <div class="card" style="width: 90%; max-width: 600px; max-height: 90vh; overflow-y: auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 16px; margin-bottom: 16px;">
      <h3 style="font-size: 18px; font-weight: 600;">Announcement / Popup</h3>
      <button onclick="closeModal('announcementModal')" style="background: none; border: none; cursor: pointer;"><i data-lucide="x"></i></button>
    </div>
    <form id="announcementForm" onsubmit="handleFormSubmit(event, 'announcements')">
      <input type="hidden" id="announcementId" name="id">
      <div class="form-group mb-3">
        <label>Title</label>
        <input type="text" name="title" class="form-control" required>
      </div>
      <div class="form-group mb-3">
        <label>Message</label>
        <textarea name="message" class="form-control" rows="3" required></textarea>
      </div>
      <div class="responsive-grid-2 mb-3">
        <div class="form-group">
          <label>Type</label>
          <select name="type" class="form-control" required>
            <option value="ANNOUNCEMENT">General Announcement</option>
            <option value="NEW_PROJECT">New Project</option>
            <option value="OFFER">Special Offer</option>
            <option value="WARNING">Warning / Notice</option>
          </select>
        </div>
        <div class="form-group">
          <label>Priority</label>
          <select name="priority" class="form-control" required>
            <option value="NORMAL">Normal</option>
            <option value="IMPORTANT">Important</option>
            <option value="HIGH">High</option>
            <option value="CRITICAL">Critical</option>
          </select>
        </div>
      </div>
      <div class="responsive-grid-2 mb-3">
        <div class="form-group">
          <label>Display Frequency</label>
          <select name="displayFrequency" class="form-control" required>
            <option value="ONCE_PER_SESSION">Once Per Session</option>
            <option value="EVERY_VISIT">Every Dashboard Load</option>
            <option value="UNTIL_DISMISSED">Until User Dismisses</option>
          </select>
        </div>
        <div class="form-group">
          <label>Target Role</label>
          <select name="targetRole" class="form-control" required>
            <option value="ALL">All Users</option>
            <option value="MD">Managing Directors Only</option>
            <option value="AM">Associate Managers Only</option>
            <option value="ASSOCIATE">Associates Only</option>
          </select>
        </div>
      </div>
      <div class="form-group mb-3">
        <label>Status</label>
        <select name="isActive" class="form-control">
          <option value="true">Active</option>
          <option value="false">Inactive</option>
        </select>
      </div>
      <div style="display: flex; justify-content: flex-end; gap: 12px;">
        <button type="button" class="btn btn-secondary" onclick="closeModal('announcementModal')">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Announcement</button>
      </div>
    </form>
  </div>
</div>

<script>
  // Tab Logic
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('active');
        b.style.borderBottomColor = 'transparent';
        b.style.color = 'var(--text-muted)';
      });
      document.querySelectorAll('.tab-content').forEach(c => c.style.display = 'none');
      
      btn.classList.add('active');
      btn.style.borderBottomColor = 'var(--primary)';
      btn.style.color = 'var(--primary)';
      document.getElementById('tab-' + btn.dataset.tab).style.display = 'block';
      loadData(btn.dataset.tab);
    });
  });

  // Modal Logic
  function openModal(id, data = null) {
    document.getElementById(id).style.display = 'flex';
    const form = document.getElementById(id.replace('Modal', 'Form'));
    form.reset();
    if (data) {
      Object.keys(data).forEach(key => {
        if (form.elements[key]) {
          if (typeof data[key] === 'boolean') {
            form.elements[key].value = data[key].toString();
          } else {
            form.elements[key].value = data[key];
          }
        }
      });
    }
  }

  function closeModal(id) {
    document.getElementById(id).style.display = 'none';
  }

  // Data Loading
  async function loadData(type) {
    try {
      const res = await fetch(`/api/dashboard/${type}`);
      const data = await res.json();
      if (data.success) {
        renderTable(type, data.data);
      }
    } catch (e) {
      console.error(e);
    }
  }

  function renderTable(type, items) {
    const tbody = document.getElementById(`${type}-list`);
    if (items.length === 0) {
      tbody.innerHTML = `<tr><td colspan="6" class="text-center text-muted">No ${type} found.</td></tr>`;
      return;
    }
    
    let html = '';
    items.forEach(item => {
      const statusClass = item.isActive ? 'status-approved' : 'status-rejected';
      const statusText = item.isActive ? 'Active' : 'Inactive';
      
      if (type === 'carousel') {
        html += `
          <tr>
            <td><img src="${item.image}" style="width: 80px; height: 40px; object-fit: cover; border-radius: 4px;"></td>
            <td style="font-weight: 500;">${item.title || 'No title'}</td>
            <td><span class="status-chip ${statusClass}">${statusText}</span></td>
            <td>${item.priority || 0}</td>
            <td>
              <button class="btn btn-secondary btn-sm" onclick='editItem("${type}", ${JSON.stringify(item).replace(/'/g, "&apos;")})'>Edit</button>
              <button class="btn btn-secondary btn-sm" style="color: var(--error);" onclick="deleteItem('${type}', '${item.id}')">Delete</button>
            </td>
          </tr>
        `;
      } else if (type === 'offers') {
        html += `
          <tr>
            <td style="font-weight: 500;">${item.title}</td>
            <td>${item.offerType}</td>
            <td><span class="status-chip ${statusClass}">${statusText}</span></td>
            <td>${item.endDate ? new Date(item.endDate).toLocaleDateString() : 'No expiry'}</td>
            <td>
              <button class="btn btn-secondary btn-sm" onclick='editItem("${type}", ${JSON.stringify(item).replace(/'/g, "&apos;")})'>Edit</button>
              <button class="btn btn-secondary btn-sm" style="color: var(--error);" onclick="deleteItem('${type}', '${item.id}')">Delete</button>
            </td>
          </tr>
        `;
      } else if (type === 'announcements') {
        html += `
          <tr>
            <td style="font-weight: 500;">${item.title}</td>
            <td>${item.type}</td>
            <td>${item.targetRole}</td>
            <td>${item.displayFrequency.replace(/_/g, ' ')}</td>
            <td><span class="status-chip ${statusClass}">${statusText}</span></td>
            <td>
              <button class="btn btn-secondary btn-sm" onclick='editItem("${type}", ${JSON.stringify(item).replace(/'/g, "&apos;")})'>Edit</button>
              <button class="btn btn-secondary btn-sm" style="color: var(--error);" onclick="deleteItem('${type}', '${item.id}')">Delete</button>
            </td>
          </tr>
        `;
      }
    });
    tbody.innerHTML = html;
  }

  // Forms
  function editItem(type, item) {
    const modalId = type === 'carousel' ? 'carouselModal' : type === 'offers' ? 'offerModal' : 'announcementModal';
    openModal(modalId, item);
  }

  async function handleFormSubmit(e, type) {
    e.preventDefault();
    const form = e.target;
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    const id = data.id;
    delete data.id;

    const method = id ? 'PUT' : 'POST';
    const url = id ? `/api/dashboard/${type}/${id}` : `/api/dashboard/${type}`;

    try {
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await res.json();
      if (result.success) {
        closeModal(form.closest('.modal').id);
        loadData(type);
      } else {
        alert(result.error);
      }
    } catch (err) {
      alert('Error saving data');
    }
  }

  async function deleteItem(type, id) {
    if (!confirm('Are you sure you want to delete this item?')) return;
    try {
      const res = await fetch(`/api/dashboard/${type}/${id}`, { method: 'DELETE' });
      const result = await res.json();
      if (result.success) loadData(type);
    } catch (err) {
      alert('Error deleting item');
    }
  }

  // Init
  loadData('carousel');
</script>

<%- include('../partials/footer') %>
