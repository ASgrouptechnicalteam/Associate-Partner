<%- include('../partials/head') %>

<div>
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-6);">
    <div>
      <h1 style="font-size: 24px; font-weight: 700;">Global Associate Directory</h1>
      <p class="text-muted">Master view of all associates in the system.</p>
    </div>
    <a href="/associates/new" class="btn btn-primary">Add Associate</a>
  </div>

  <div class="card" style="padding: var(--space-4);">
    <div id="associates-container"><p class="text-muted">Loading associates...</p></div>
  </div>
</div>

<script>
  async function fetchAssociates() {
    try {
      const res = await fetch('/api/admin/associates');
      const data = await res.json();
      if (data.success) {
        renderAssociates(data.associates);
      }
    } catch (e) {
      document.getElementById('associates-container').innerHTML = '<p class="text-error">Failed to load associates.</p>';
    }
  }

  function renderAssociates(associates) {
    if (!associates || associates.length === 0) {
      document.getElementById('associates-container').innerHTML = '<p class="text-muted">No associates found.</p>';
      return;
    }

    let html = '<div class="table-wrapper"><table class="data-table" style="width: 100%; border-collapse: collapse; font-size: 14px;">';
    html += `
      <thead>
        <tr style="border-bottom: 1px solid var(--border-light); text-align: left; background-color: var(--bg-muted);">
          <th style="padding: 12px;">Associate Code</th>
          <th style="padding: 12px;">Name</th>
          <th style="padding: 12px;">Contact</th>
          <th style="padding: 12px;">Parent</th>
          <th style="padding: 12px;">Team Size</th>
          <th style="padding: 12px;">Status</th>
        </tr>
      </thead>
      <tbody>
    `;

    associates.forEach(asc => {
      const parentName = asc.parentAssociate ? asc.parentAssociate.name : 'None';
      const phone = asc.profile ? asc.profile.primaryPhone : 'N/A';
      const email = asc.profile ? asc.profile.email : 'N/A';
      const teamSize = asc._count.downline;
      const statusHtml = asc.isActive ? '<span class="status-chip status-active">Active</span>' : '<span class="status-chip status-pending">Inactive</span>';

      html += `
        <tr style="border-bottom: 1px solid var(--border-light);">
          <td style="padding: 12px; font-weight: 600;">${asc.userId}</td>
          <td style="padding: 12px;">${asc.name}</td>
          <td style="padding: 12px;" class="text-muted">${phone}<br>${email}</td>
          <td style="padding: 12px;">${parentName}</td>
          <td style="padding: 12px; font-weight: 600;">${teamSize}</td>
          <td style="padding: 12px;">${statusHtml}</td>
        </tr>
      `;
    });

    html += '</tbody></table></div>';
    document.getElementById('associates-container').innerHTML = html;
  }

  fetchAssociates();
</script>

<%- include('../partials/footer') %>
