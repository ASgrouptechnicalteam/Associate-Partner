      }

      // FAQs
      if (p.faqs) { try { JSON.parse(p.faqs).forEach(f => addFaqItem(f)); } catch(e){} }

      // Jump to saved wizard step
      if (p.wizardStep && p.wizardStep > 1) showStep(p.wizardStep);

    } catch(e) { console.error('Failed to load project', e); }
  }

  // --- Generate Review ---
  function generateReview() {
    const data = collectData();
    let html = '';
    const missing = [];

    // Basic
    html += `<div class="card-soft" style="padding: var(--space-4); margin-bottom: var(--space-3); border-radius: 10px;">
      <h4 style="margin-bottom: 8px; color: var(--brand-navy);">Basic Information</h4>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4px 16px; font-size: 14px;">
        <div><strong>Name:</strong> ${data.name || '—'}</div>
        <div><strong>Code:</strong> ${data.projectCode || '—'}</div>
        <div><strong>Type:</strong> ${data.projectType || '—'}</div>
        <div><strong>Status:</strong> ${data.projectStatus || '—'}</div>
      </div>
    </div>`;
    if (!data.name) missing.push('Project Name');
    if (!data.projectType) missing.push('Project Type');

    // Location
    try {
      const loc = JSON.parse(data.locationData);
      html += `<div class="card-soft" style="padding: var(--space-4); margin-bottom: var(--space-3); border-radius: 10px;">
        <h4 style="margin-bottom: 8px; color: var(--brand-navy);">Location</h4>
        <div style="font-size: 14px;">${loc.city || '—'}, ${loc.district || '—'}, ${loc.state || '—'}</div>
        <div style="font-size: 13px; color: var(--text-muted);">${loc.address || '—'}</div>
      </div>`;
      if (!loc.state && !loc.city) missing.push('Location');
    } catch(e){}

    // Amenities
    try {
      const am = JSON.parse(data.amenities);
      html += `<div class="card-soft" style="padding: var(--space-4); margin-bottom: var(--space-3); border-radius: 10px;">
        <h4 style="margin-bottom: 8px; color: var(--brand-navy);">Amenities (${am.length})</h4>
        <div style="font-size: 14px;">${am.length > 0 ? am.join(', ') : 'None selected'}</div>
      </div>`;
    } catch(e){}

    // FAQs
    try {
      const faqs = JSON.parse(data.faqs);
      html += `<div class="card-soft" style="padding: var(--space-4); margin-bottom: var(--space-3); border-radius: 10px;">
        <h4 style="margin-bottom: 8px; color: var(--brand-navy);">FAQs (${faqs.length})</h4>
      </div>`;
    } catch(e){}

    document.getElementById('review-content').innerHTML = html;

    // Warnings
    if (missing.length > 0) {
      document.getElementById('review-warnings').innerHTML = `
        <div style="background: #FEF2F2; border: 1px solid #FECACA; border-radius: 10px; padding: var(--space-4);">
          <h4 style="color: #DC2626; margin-bottom: 8px;">⚠ Missing Required Fields</h4>
          <ul style="margin: 0; padding-left: 20px; font-size: 14px; color: #991B1B;">${missing.map(m => `<li>${m}</li>`).join('')}</ul>
        </div>`;
    } else {
      document.getElementById('review-warnings').innerHTML = `
        <div style="background: #ECFDF5; border: 1px solid #A7F3D0; border-radius: 10px; padding: var(--space-4);">
          <h4 style="color: #059669;">✓ All required fields are complete</h4>
          <p style="font-size: 14px; color: #065F46; margin-top: 4px;">This project is ready to submit for MD approval.</p>
        </div>`;
    }
  }

  // Preload default FAQ questions for new projects
  if (!projectId) {
    defaultFAQs.forEach(q => addFaqItem({ question: q, answer: '' }));
  }
</script>

