<%- include('../partials/head') %>

<div>
  <!-- Header with progress -->
  <div style="margin-bottom: var(--space-6);">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-3); margin-bottom: var(--space-4);">
      <div>
        <h1 style="font-size: 22px; font-weight: 700;">Project Wizard</h1>
        <p class="text-muted" id="step-label">Step 1 of 15 — Basic Information</p>
      </div>
      <div style="display: flex; gap: 8px; flex-wrap: wrap;">
        <button class="btn btn-secondary" id="saveDraftBtn" onclick="saveDraft()">Save Draft</button>
        <a href="/projects" class="btn btn-secondary">Cancel</a>
      </div>
    </div>
    
    <!-- Progress bar -->
    <div style="background: var(--surface-muted); border-radius: 8px; height: 8px; overflow: hidden;">
      <div id="progress-bar" style="width: 6.67%; height: 100%; background: linear-gradient(90deg, var(--brand-gold) 0%, #f59e0b 100%); border-radius: 8px; transition: width 0.3s ease;"></div>
    </div>
  </div>

  <!-- Wizard Steps Container -->
  <div class="card" style="padding: var(--space-6);">

    <!-- STEP 1: Basic Information -->
    <div class="wizard-step" id="step-1">
      <h3 style="margin-bottom: var(--space-4); border-bottom: 1px solid var(--border); padding-bottom: 8px;">Basic Project Information</h3>
      <div class="responsive-grid-2">
        <div class="input-group">
          <label class="input-label">Project Name *</label>
          <input type="text" id="f-name" class="input-control" required />
        </div>
        <div class="input-group">
          <label class="input-label">Project Code / ID</label>
          <input type="text" id="f-projectCode" class="input-control" placeholder="e.g. PROJ-001" />
        </div>
        <div class="input-group">
          <label class="input-label">Project Type *</label>
          <select id="f-projectType" class="input-control">
            <option value="">Select type</option>
            <option value="Residential Plots">Residential Plots</option>
            <option value="Villas">Villas</option>
            <option value="Apartments">Apartments</option>
            <option value="Commercial">Commercial</option>
            <option value="Farm Land">Farm Land</option>
            <option value="Mixed Development">Mixed Development</option>
          </select>
        </div>
        <div class="input-group">
          <label class="input-label">Project Status *</label>
          <select id="f-projectStatus" class="input-control">
            <option value="">Select status</option>
            <option value="Upcoming">Upcoming</option>
            <option value="Pre-Launch">Pre-Launch</option>
            <option value="Launch">Launch</option>
            <option value="Under Development">Under Development</option>
            <option value="Ready to Occupy">Ready to Occupy</option>
            <option value="Sold Out">Sold Out</option>
          </select>
        </div>
        <div class="input-group">
          <label class="input-label">Developer / Builder Name</label>
          <input type="text" id="f-developerName" class="input-control" />
        </div>
        <div class="input-group">
          <label class="input-label">Marketing Company</label>
          <input type="text" id="f-marketingCompany" class="input-control" />
        </div>
      </div>
      <div class="responsive-grid-2" style="margin-top: 0;">
        <div class="input-group" style="grid-column: 1 / -1;">
          <label class="input-label">Description</label>
          <textarea id="f-description" class="input-control" rows="3" style="height: auto;"></textarea>
        </div>
      </div>
      <h4 style="margin-bottom: var(--space-3); font-size: 15px; color: var(--text-secondary);">Dates</h4>
      <div class="responsive-grid-2" style="margin-bottom: 0;">
        <div class="input-group">
          <label class="input-label">Date of Launch</label>
          <input type="date" id="f-launchDate" class="input-control" />
        </div>
        <div class="input-group">
          <label class="input-label">Expected Completion</label>
          <input type="date" id="f-completionDate" class="input-control" />
        </div>
        <div class="input-group">
          <label class="input-label">Possession Date</label>
          <input type="date" id="f-possessionDate" class="input-control" />
        </div>
      </div>
    </div>

    <!-- STEP 2: Location -->
    <div class="wizard-step" id="step-2" style="display: none;">
      <h3 style="margin-bottom: var(--space-4); border-bottom: 1px solid var(--border); padding-bottom: 8px;">Location Details</h3>
      <div class="responsive-grid-2">
        <div class="input-group"><label class="input-label">State</label><input type="text" id="f-loc-state" class="input-control" /></div>
        <div class="input-group"><label class="input-label">District</label><input type="text" id="f-loc-district" class="input-control" /></div>
        <div class="input-group"><label class="input-label">City / Town</label><input type="text" id="f-loc-city" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Village</label><input type="text" id="f-loc-village" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Survey Numbers</label><input type="text" id="f-loc-survey" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Landmark</label><input type="text" id="f-loc-landmark" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Latitude</label><input type="text" id="f-loc-lat" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Longitude</label><input type="text" id="f-loc-lng" class="input-control" /></div>
      </div>
      <div class="input-group"><label class="input-label">Complete Address</label><textarea id="f-loc-address" class="input-control" rows="2" style="height: auto;"></textarea></div>
      
      <h4 style="margin: var(--space-5) 0 var(--space-3); font-size: 15px; color: var(--text-secondary);">Distances (km)</h4>
      <div class="responsive-grid-2" style="margin-bottom: 0;">
        <div class="input-group"><label class="input-label">Highway</label><input type="text" id="f-loc-highway" class="input-control" placeholder="e.g. 2 km" /></div>
        <div class="input-group"><label class="input-label">Airport</label><input type="text" id="f-loc-airport" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Railway Station</label><input type="text" id="f-loc-railway" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Bus Stand</label><input type="text" id="f-loc-bus" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Schools</label><input type="text" id="f-loc-schools" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Hospitals</label><input type="text" id="f-loc-hospitals" class="input-control" /></div>
      </div>
    </div>

    <!-- STEP 3: Legal -->
    <div class="wizard-step" id="step-3" style="display: none;">
      <h3 style="margin-bottom: var(--space-4); border-bottom: 1px solid var(--border); padding-bottom: 8px;">Legal Information</h3>
      <p class="text-muted" style="margin-bottom: var(--space-4);">Add legal approvals, certificates, and documents.</p>
      <div id="legal-items"></div>
      <button type="button" class="btn btn-secondary" onclick="addLegalItem()" style="margin-top: var(--space-3);">+ Add Approval / Document</button>
    </div>

    <!-- STEP 4: Land Details -->
    <div class="wizard-step" id="step-4" style="display: none;">
      <h3 style="margin-bottom: var(--space-4); border-bottom: 1px solid var(--border); padding-bottom: 8px;">Land Details</h3>
      <div class="responsive-grid-2">
        <div class="input-group"><label class="input-label">Total Land Area</label><input type="text" id="f-land-totalArea" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Saleable Area</label><input type="text" id="f-land-saleableArea" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Open Space</label><input type="text" id="f-land-openSpace" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Road Area</label><input type="text" id="f-land-roadArea" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Park Area</label><input type="text" id="f-land-parkArea" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Clubhouse Area</label><input type="text" id="f-land-clubhouseArea" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Green Belt</label><input type="text" id="f-land-greenBelt" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Number of Blocks</label><input type="number" id="f-land-blocks" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Number of Plots</label><input type="number" id="f-land-plots" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Phase Details</label><input type="text" id="f-land-phases" class="input-control" /></div>
      </div>
      <div class="input-group"><label class="input-label">Plot Dimensions / Sizes</label><textarea id="f-land-plotDimensions" class="input-control" rows="2" style="height: auto;" placeholder="e.g. 30x40, 30x50, 40x60"></textarea></div>
      <div class="input-group" style="margin-bottom: 0;"><label class="input-label">Plot Facings Available</label><textarea id="f-land-plotFacing" class="input-control" rows="2" style="height: auto;" placeholder="e.g. North, South, East, West"></textarea></div>
    </div>

    <!-- STEP 5: Inventory -->
    <div class="wizard-step" id="step-5" style="display: none;">
      <h3 style="margin-bottom: var(--space-4); border-bottom: 1px solid var(--border); padding-bottom: 8px;">Inventory Management</h3>
      <p class="text-muted" style="margin-bottom: var(--space-4);">Manage individual units/plots. Save the project first, then add units here.</p>
      <div id="inventory-container">
        <div class="text-muted" style="text-align: center; padding: var(--space-6);">Save the project as a draft first to manage inventory units.</div>
      </div>
    </div>

    <!-- STEP 6: Pricing -->
    <div class="wizard-step" id="step-6" style="display: none;">
      <h3 style="margin-bottom: var(--space-4); border-bottom: 1px solid var(--border); padding-bottom: 8px;">Pricing</h3>
      <div class="responsive-grid-2">
        <div class="input-group"><label class="input-label">Price per Sq. Yard</label><input type="text" id="f-price-sqyard" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Price per Sq. Ft.</label><input type="text" id="f-price-sqft" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Registration Charges</label><input type="text" id="f-price-registration" class="input-control" /></div>
        <div class="input-group"><label class="input-label">GST</label><input type="text" id="f-price-gst" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Development Charges</label><input type="text" id="f-price-devCharges" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Maintenance Charges</label><input type="text" id="f-price-maintenance" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Clubhouse Charges</label><input type="text" id="f-price-clubhouse" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Parking Charges</label><input type="text" id="f-price-parking" class="input-control" /></div>
        <div class="input-group"><label class="input-label">PLC (Preferential Location)</label><input type="text" id="f-price-plc" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Documentation Charges</label><input type="text" id="f-price-documentation" class="input-control" /></div>
      </div>
      <h4 style="margin-bottom: var(--space-3); font-size: 15px; color: var(--text-secondary);">Offers / Discounts</h4>
      <div class="input-group"><label class="input-label">Customer Offers</label><textarea id="f-customerOffers" class="input-control" rows="2" style="height: auto;"></textarea></div>
      <div class="input-group" style="margin-bottom: 0;"><label class="input-label">Associate Offers</label><textarea id="f-associateOffers" class="input-control" rows="2" style="height: auto;"></textarea></div>
    </div>

    <!-- STEP 7: Payment Plans -->
    <div class="wizard-step" id="step-7" style="display: none;">
      <h3 style="margin-bottom: var(--space-4); border-bottom: 1px solid var(--border); padding-bottom: 8px;">Payment Plans</h3>
      <div class="responsive-grid-2">
        <div class="input-group"><label class="input-label">Down Payment</label><input type="text" id="f-pay-downPayment" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Booking Amount</label><input type="text" id="f-pay-bookingAmount" class="input-control" /></div>
        <div class="input-group"><label class="input-label">EMI Options</label><input type="text" id="f-pay-emiOptions" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Bank Loan Available</label>
          <select id="f-pay-bankLoan" class="input-control"><option value="Yes">Yes</option><option value="No">No</option></select>
        </div>
        <div class="input-group"><label class="input-label">Partner Banks</label><input type="text" id="f-pay-partnerBanks" class="input-control" placeholder="SBI, HDFC, ICICI..." /></div>
        <div class="input-group"><label class="input-label">Interest Rate</label><input type="text" id="f-pay-interestRate" class="input-control" /></div>
      </div>
      <div class="input-group"><label class="input-label">Cancellation Policy</label><textarea id="f-pay-cancellationPolicy" class="input-control" rows="2" style="height: auto;"></textarea></div>
      <div class="input-group" style="margin-bottom: 0;"><label class="input-label">Refund Policy</label><textarea id="f-pay-refundPolicy" class="input-control" rows="2" style="height: auto;"></textarea></div>
    </div>

    <!-- STEP 8: Amenities -->
    <div class="wizard-step" id="step-8" style="display: none;">
      <h3 style="margin-bottom: var(--space-4); border-bottom: 1px solid var(--border); padding-bottom: 8px;">Amenities</h3>
      <p class="text-muted" style="margin-bottom: var(--space-4);">Select all available amenities.</p>
      <div id="amenities-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px;"></div>
      <div class="input-group" style="margin-top: var(--space-4); margin-bottom: 0;">
        <label class="input-label">Custom Amenities (comma separated)</label>
        <input type="text" id="f-customAmenities" class="input-control" placeholder="e.g. Yoga Center, Dog Park" />
      </div>
    </div>

    <!-- STEP 9: Infrastructure -->
    <div class="wizard-step" id="step-9" style="display: none;">
      <h3 style="margin-bottom: var(--space-4); border-bottom: 1px solid var(--border); padding-bottom: 8px;">Nearby Infrastructure</h3>
      <p class="text-muted" style="margin-bottom: var(--space-4);">Add nearby landmarks, institutions, and facilities.</p>
      <div id="infra-items"></div>
      <button type="button" class="btn btn-secondary" onclick="addInfraItem()" style="margin-top: var(--space-3);">+ Add Nearby Place</button>
    </div>

    <!-- STEP 10: Construction -->
    <div class="wizard-step" id="step-10" style="display: none;">
      <h3 style="margin-bottom: var(--space-4); border-bottom: 1px solid var(--border); padding-bottom: 8px;">Construction Details</h3>
      <p class="text-muted" style="margin-bottom: var(--space-4);">Applicable for Apartments, Villas, and Mixed Development.</p>
      <div class="responsive-grid-2">
        <div class="input-group"><label class="input-label">Number of Floors</label><input type="number" id="f-con-floors" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Number of Towers</label><input type="number" id="f-con-towers" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Total Units</label><input type="number" id="f-con-totalUnits" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Built-up Area</label><input type="text" id="f-con-builtUpArea" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Carpet Area</label><input type="text" id="f-con-carpetArea" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Super Built-up Area</label><input type="text" id="f-con-superBuiltUpArea" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Structure Type</label><input type="text" id="f-con-structureType" class="input-control" placeholder="e.g. RCC Frame" /></div>
        <div class="input-group"><label class="input-label">Flooring</label><input type="text" id="f-con-flooring" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Plumbing</label><input type="text" id="f-con-plumbing" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Electrical</label><input type="text" id="f-con-electrical" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Doors</label><input type="text" id="f-con-doors" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Windows</label><input type="text" id="f-con-windows" class="input-control" /></div>
      </div>
    </div>

    <!-- STEP 11: Marketing -->
    <div class="wizard-step" id="step-11" style="display: none;">
      <h3 style="margin-bottom: var(--space-4); border-bottom: 1px solid var(--border); padding-bottom: 8px;">Marketing Information</h3>
      <div class="input-group"><label class="input-label">USP (Unique Selling Proposition)</label><textarea id="f-mkt-usp" class="input-control" rows="2" style="height: auto;"></textarea></div>
      <div class="responsive-grid-2">
        <div class="input-group"><label class="input-label">Target Audience</label><input type="text" id="f-mkt-targetAudience" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Investment Potential</label><input type="text" id="f-mkt-investmentPotential" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Expected ROI (%)</label><input type="text" id="f-mkt-expectedROI" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Rental Potential</label><input type="text" id="f-mkt-rentalPotential" class="input-control" /></div>
      </div>
      <div class="input-group" style="margin-bottom: 0;"><label class="input-label">Future Growth Factors</label><textarea id="f-mkt-futureGrowth" class="input-control" rows="2" style="height: auto;"></textarea></div>
    </div>

    <!-- STEP 12: Media -->
    <div class="wizard-step" id="step-12" style="display: none;">
      <h3 style="margin-bottom: var(--space-4); border-bottom: 1px solid var(--border); padding-bottom: 8px;">Media Library</h3>
      <p class="text-muted" style="margin-bottom: var(--space-4);">Upload brochures, layouts, gallery images, and videos. Media files are uploaded individually after saving the project draft.</p>
      <div class="responsive-grid-2">
        <div class="input-group">
          <%- include('../partials/file-upload', {
            name: 'brochure',
            id: 'f-media-brochure',
            label: 'Brochure (PDF)',
            accept: '.pdf',
            required: false
          }) %>
        </div>
        <div class="input-group">
          <%- include('../partials/file-upload', {
            name: 'layout',
            id: 'f-media-layout',
            label: 'Layout Plan',
            accept: '.pdf,image/*',
            required: false
          }) %>
        </div>
        <div class="input-group" style="grid-column: 1 / -1;">
          <%- include('../partials/file-upload', {
            name: 'gallery',
            id: 'f-media-gallery',
            label: 'Gallery Images',
            accept: 'image/*',
            multiple: true,
            required: false
          }) %>
        </div>
      </div>
    </div>

    <!-- STEP 13: Sales Assignment -->
    <div class="wizard-step" id="step-13" style="display: none;">
      <h3 style="margin-bottom: var(--space-4); border-bottom: 1px solid var(--border); padding-bottom: 8px;">Sales Assignment</h3>
      <div class="responsive-grid-2">
        <div class="input-group"><label class="input-label">Assigned Sales Manager</label><input type="text" id="f-sales-manager" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Assigned Telecaller</label><input type="text" id="f-sales-telecaller" class="input-control" /></div>
        <div class="input-group"><label class="input-label">Project Manager</label><input type="text" id="f-sales-projectManager" class="input-control" /></div>
      </div>
      <div id="inventory-summary" style="margin-top: var(--space-4);"></div>
    </div>

    <!-- STEP 14: FAQs -->
    <div class="wizard-step" id="step-14" style="display: none;">
      <h3 style="margin-bottom: var(--space-4); border-bottom: 1px solid var(--border); padding-bottom: 8px;">Customer FAQs</h3>
      <p class="text-muted" style="margin-bottom: var(--space-4);">Add common questions and answers customers may ask.</p>
      <div id="faq-items"></div>
      <button type="button" class="btn btn-secondary" onclick="addFaqItem()" style="margin-top: var(--space-3);">+ Add FAQ</button>
    </div>

    <!-- STEP 15: Review & Publish -->
    <div class="wizard-step" id="step-15" style="display: none;">
      <h3 style="margin-bottom: var(--space-4); border-bottom: 1px solid var(--border); padding-bottom: 8px;">Review & Publish</h3>
      <div id="review-content"></div>
      <div id="review-warnings" style="margin-top: var(--space-4);"></div>
    </div>

  </div>

  <!-- Navigation Buttons -->
  <div style="display: flex; justify-content: space-between; align-items: center; margin-top: var(--space-6); flex-wrap: wrap; gap: var(--space-3);">
    <button class="btn btn-secondary" id="prevBtn" onclick="prevStep()" style="display: none;">← Back</button>
    <div style="margin-left: auto; display: flex; gap: 8px;">
      <button class="btn btn-secondary" onclick="saveDraft()">Save Draft</button>
      <button class="btn btn-primary" id="nextBtn" onclick="nextStep()">Next →</button>
      <button class="btn btn-gold" id="submitBtn" onclick="submitForApproval()" style="display: none;">Submit for Approval</button>
    </div>
  </div>
</div>

<script>
  const TOTAL_STEPS = 15;
  let currentStep = 1;
  let projectId = null; // Set if editing existing

  const stepNames = [
    '', 'Basic Information', 'Location', 'Legal', 'Land Details', 'Inventory',
    'Pricing', 'Payment Plans', 'Amenities', 'Nearby Infrastructure',
    'Construction', 'Marketing', 'Media', 'Sales Assignment', 'FAQs', 'Review & Publish'
  ];

  // Check if editing
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('id')) {
    projectId = urlParams.get('id');
    loadExistingProject(projectId);
  }

  // --- Amenities Checkboxes ---
  const defaultAmenities = [
    '40/60/80/100 Feet Roads', 'Street Lights', 'Underground Electricity', 'Underground Drainage',
    'Water Supply', 'Overhead Tank', 'Parks', 'Children\'s Play Area', 'Jogging Track',
    'Clubhouse', 'Swimming Pool', 'Gym', 'CCTV', 'Security', 'Compound Wall',
    'Landscaped Gardens', 'Rainwater Harvesting', 'Solar Lighting', 'EV Charging', 'Wi-Fi Zone'
  ];
  const amenGrid = document.getElementById('amenities-grid');
  defaultAmenities.forEach(a => {
    amenGrid.innerHTML += `<label style="display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: var(--surface-muted); border-radius: 8px; cursor: pointer; font-size: 14px;">
      <input type="checkbox" class="amenity-cb" value="${a}" /> ${a}
    </label>`;
  });

  // --- Default FAQs ---
  const defaultFAQs = [
    'Is the project legally approved?', 'Is a bank loan available?', 'What is the price?',
    'What are the nearby landmarks?', 'Is registration included?', 'What amenities are available?',
    'Is it suitable for investment?', 'What is the expected appreciation?',
    'What is the possession timeline?', 'What EMI options are available?', 'What documents are required?'
  ];

  let legalCounter = 0;
  let infraCounter = 0;
  let faqCounter = 0;

  function addLegalItem(data) {
    legalCounter++;
    const d = data || {};
    document.getElementById('legal-items').insertAdjacentHTML('beforeend', `
