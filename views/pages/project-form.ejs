          document.getElementById('f-loc-district').value = loc.district || '';
          document.getElementById('f-loc-city').value = loc.city || '';
          document.getElementById('f-loc-village').value = loc.village || '';
          document.getElementById('f-loc-survey').value = loc.surveyNumbers || '';
          document.getElementById('f-loc-landmark').value = loc.landmark || '';
          document.getElementById('f-loc-lat').value = loc.lat || '';
          document.getElementById('f-loc-lng').value = loc.lng || '';
          document.getElementById('f-loc-address').value = loc.address || '';
          if (loc.distances) {
            document.getElementById('f-loc-highway').value = loc.distances.highway || '';
            document.getElementById('f-loc-airport').value = loc.distances.airport || '';
            document.getElementById('f-loc-railway').value = loc.distances.railway || '';
            document.getElementById('f-loc-bus').value = loc.distances.bus || '';
            document.getElementById('f-loc-schools').value = loc.distances.schools || '';
            document.getElementById('f-loc-hospitals').value = loc.distances.hospitals || '';
          }
        } catch(e){}
      }

      // Legal
      if (p.legalData) { try { JSON.parse(p.legalData).forEach(l => addLegalItem(l)); } catch(e){} }

      // Land
      if (p.landData) {
        try {
          const ld = JSON.parse(p.landData);
          ['totalArea','saleableArea','openSpace','roadArea','parkArea','clubhouseArea','greenBelt','blocks','plots','phases','plotDimensions','plotFacing'].forEach(k => {
            const el = document.getElementById('f-land-' + k);
            if (el && ld[k]) el.value = ld[k];
          });
        } catch(e){}
      }

      // Pricing
      if (p.pricingData) {
        try {
          const pr = JSON.parse(p.pricingData);
          document.getElementById('f-price-sqyard').value = pr.pricePerSqYard || '';
          document.getElementById('f-price-sqft').value = pr.pricePerSqFt || '';
          document.getElementById('f-price-registration').value = pr.registration || '';
          document.getElementById('f-price-gst').value = pr.gst || '';
          document.getElementById('f-price-devCharges').value = pr.devCharges || '';
          document.getElementById('f-price-maintenance').value = pr.maintenance || '';
          document.getElementById('f-price-clubhouse').value = pr.clubhouse || '';
          document.getElementById('f-price-parking').value = pr.parking || '';
          document.getElementById('f-price-plc').value = pr.plc || '';
          document.getElementById('f-price-documentation').value = pr.documentation || '';
        } catch(e){}
      }
      document.getElementById('f-customerOffers').value = p.customerOffers || '';
      document.getElementById('f-associateOffers').value = p.associateOffers || '';

      // Payment
      if (p.paymentPlanData) {
        try {
          const pp = JSON.parse(p.paymentPlanData);
          document.getElementById('f-pay-downPayment').value = pp.downPayment || '';
          document.getElementById('f-pay-bookingAmount').value = pp.bookingAmount || '';
          document.getElementById('f-pay-emiOptions').value = pp.emiOptions || '';
          document.getElementById('f-pay-bankLoan').value = pp.bankLoan || 'Yes';
          document.getElementById('f-pay-partnerBanks').value = pp.partnerBanks || '';
          document.getElementById('f-pay-interestRate').value = pp.interestRate || '';
          document.getElementById('f-pay-cancellationPolicy').value = pp.cancellationPolicy || '';
          document.getElementById('f-pay-refundPolicy').value = pp.refundPolicy || '';
        } catch(e){}
      }

      // Amenities
      if (p.amenities) {
        try {
          const am = JSON.parse(p.amenities);
          document.querySelectorAll('.amenity-cb').forEach(cb => { if (am.includes(cb.value)) cb.checked = true; });
        } catch(e){}
      }

      // Infrastructure
      if (p.infrastructure) { try { JSON.parse(p.infrastructure).forEach(i => addInfraItem(i)); } catch(e){} }

      // Construction
      if (p.constructionData) {
        try {
          const c = JSON.parse(p.constructionData);
          ['floors','towers','totalUnits','builtUpArea','carpetArea','superBuiltUpArea','structureType','flooring','plumbing','electrical','doors','windows'].forEach(k => {
            const el = document.getElementById('f-con-' + k);
            if (el && c[k]) el.value = c[k];
          });
        } catch(e){}
      }

      // Marketing
      if (p.marketingData) {
        try {
          const m = JSON.parse(p.marketingData);
          document.getElementById('f-mkt-usp').value = m.usp || '';
          document.getElementById('f-mkt-targetAudience').value = m.targetAudience || '';
          document.getElementById('f-mkt-investmentPotential').value = m.investmentPotential || '';
          document.getElementById('f-mkt-expectedROI').value = m.expectedROI || '';
          document.getElementById('f-mkt-rentalPotential').value = m.rentalPotential || '';
