  // --- Save Draft ---
  async function saveDraft() {
    const btn = document.getElementById('saveDraftBtn');
    btn.textContent = 'Saving...';
    btn.disabled = true;
    try {
      const data = collectData();
      const res = await fetch('/api/projects/draft', {
        method: projectId ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await res.json();
      if (result.success) {
        projectId = result.project.id;
        btn.textContent = '✓ Saved';
        setTimeout(() => { btn.textContent = 'Save Draft'; }, 2000);
      } else {
        alert('Error: ' + (result.error || 'Failed to save'));
        btn.textContent = 'Save Draft';
      }
    } catch (e) {
      alert('Network error');
      btn.textContent = 'Save Draft';
    }
    btn.disabled = false;
  }

  // --- Submit for Approval ---
  async function submitForApproval() {
    if (!projectId) {
      await saveDraft();
      if (!projectId) return alert('Please save the project first.');
    }
    await saveDraft();

    try {
      const res = await fetch('/api/projects/' + projectId + '/submit', { method: 'POST' });
      const result = await res.json();
      if (result.success) {
        alert('Project submitted for MD approval!');
        window.location.href = '/projects';
      } else {
        let msg = result.error || 'Failed to submit';
        if (result.missing) msg += '\n\nMissing: ' + result.missing.join(', ');
        alert(msg);
      }
    } catch (e) {
      alert('Network error');
    }
  }

  // --- Load existing project for editing ---
  async function loadExistingProject(id) {
    try {
      const res = await fetch('/api/projects/' + id);
      const result = await res.json();
      if (!result.success) return;
      const p = result.project;

      document.getElementById('f-name').value = p.name || '';
      document.getElementById('f-projectCode').value = p.projectCode || '';
      document.getElementById('f-projectType').value = p.projectType || '';
      document.getElementById('f-projectStatus').value = p.projectStatus || '';
      document.getElementById('f-developerName').value = p.developerName || '';
      document.getElementById('f-marketingCompany').value = p.marketingCompany || '';
      document.getElementById('f-description').value = p.description || '';
      if (p.launchDate) document.getElementById('f-launchDate').value = p.launchDate.split('T')[0];
      if (p.completionDate) document.getElementById('f-completionDate').value = p.completionDate.split('T')[0];
      if (p.possessionDate) document.getElementById('f-possessionDate').value = p.possessionDate.split('T')[0];

      // Location
      if (p.locationData) {
        try {
          const loc = JSON.parse(p.locationData);
