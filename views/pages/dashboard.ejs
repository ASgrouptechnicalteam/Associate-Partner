<%- include('../partials/head') %>

<style>
  /* Base Dashboard Styles */
  .section-title {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  /* Hero Carousel */
  .hero-carousel {
    position: relative;
    width: 100%;
    height: 350px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: var(--space-6);
    background: var(--surface);
    display: none;
    box-shadow: var(--shadow-md);
  }
  .carousel-inner {
    width: 100%;
    height: 100%;
    position: relative;
  }
  .hero-slide {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
    z-index: 0;
  }
  .hero-slide.active {
    opacity: 1;
    z-index: 1;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(15,23,42,0.9) 0%, rgba(15,23,42,0.4) 50%, transparent 100%);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: white;
  }
  .slide-tag {
    background: var(--brand-gold);
    color: var(--brand-navy);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    align-self: flex-start;
    margin-bottom: 12px;
    letter-spacing: 0.05em;
  }
  .slide-title {
    font-size: 32px;
    font-weight: 800;
    margin-bottom: 8px;
    line-height: 1.2;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
  }
  .slide-desc {
    font-size: 16px;
    opacity: 0.9;
    max-width: 500px;
    margin-bottom: 24px;
    line-height: 1.5;
  }
  .carousel-controls {
    position: absolute;
    bottom: 20px;
    left: var(--space-6);
    display: flex;
    gap: 8px;
    z-index: 2;
  }
  .carousel-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: rgba(255,255,255,0.4);
    cursor: pointer;
    transition: all 0.2s;
  }
  .carousel-dot.active {
    background: white;
    width: 24px;
    border-radius: 4px;
  }

  /* KPI Cards */
  .kpi-card {
    background: var(--surface);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    border: 1px solid var(--border-light);
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s;
  }
  .kpi-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .kpi-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .kpi-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-muted);
  }
  .kpi-icon {
    width: 40px; height: 40px;
    border-radius: var(--radius-md);
    display: flex; align-items: center; justify-content: center;
  }
  .kpi-value {
    font-size: 32px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1;
  }

  /* Popup System */
  #announcement-popup {
    position: fixed;
    inset: 0;
    background: rgba(15,23,42,0.6);
    backdrop-filter: blur(4px);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  #announcement-modal {
    background: var(--surface);
    width: 90%;
    max-width: 450px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
    transform: scale(0.95);
    transition: transform 0.3s ease;
  }

  /* Mobile Tweaks */
  @media (max-width: 768px) {
    .hero-carousel { height: 250px; }
    .slide-title { font-size: 24px; }
    .slide-desc { font-size: 14px; }
  }
  
  /* Horizontal scroll for offers/projects on mobile */
  .horizontal-scroll {
    display: flex;
    gap: var(--space-4);
    overflow-x: auto;
    padding-bottom: var(--space-2);
    scrollbar-width: none; /* Firefox */
  }
  .horizontal-scroll::-webkit-scrollbar { display: none; }
  .horizontal-scroll > * {
    flex: 0 0 calc(100% - 40px); /* Show a bit of the next card */
  }
  @media (min-width: 769px) {
    .horizontal-scroll {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      overflow-x: visible;
    }
    .horizontal-scroll > * { flex: auto; }
  }
</style>

<div>
  <!-- Hero Carousel -->
  <div id="hero-carousel" class="hero-carousel">
    <div class="carousel-inner" id="carousel-inner"></div>
    <div class="carousel-controls" id="carousel-controls"></div>
  </div>

  <!-- Header / Welcome -->
  <div style="margin-bottom: var(--space-6);">
    <p style="font-weight: 600; color: var(--text-muted); margin-bottom: 4px;">Good morning 👋</p>
    <h1 style="font-size: 28px; font-weight: 800; letter-spacing: -0.02em;"><%= user.name %></h1>
    <div style="display: inline-block; background: var(--primary-bg); color: var(--primary-dark); padding: 4px 12px; border-radius: var(--radius-pill); font-size: 12px; font-weight: 700; margin-top: 8px;">
      <%= user.role %>
    </div>
  </div>

  <div class="responsive-grid-3" style="gap: var(--space-6);">
    
    <!-- LEFT/MAIN COLUMN -->
    <div style="grid-column: span 2; display: flex; flex-direction: column; gap: var(--space-6);">
      
      <!-- KPI Overview -->
      <div>
        <h2 class="section-title">Overview</h2>
        <div id="kpi-container" class="responsive-grid-2" style="gap: var(--space-4);">
          <div class="skeleton kpi-card" style="height: 120px;"></div>
          <div class="skeleton kpi-card" style="height: 120px;"></div>
          <div class="skeleton kpi-card" style="height: 120px;"></div>
          <div class="skeleton kpi-card" style="height: 120px;"></div>
        </div>
      </div>

      <!-- Offers -->
      <div id="offers-section" style="display: none;">
        <div class="section-title">
          <span>Special Offers</span>
          <a href="/offers" style="font-size: 13px; color: var(--primary); font-weight: 600; text-decoration: none;">View All &rarr;</a>
        </div>
        <div id="offers-container" class="horizontal-scroll"></div>
      </div>

      <!-- Featured Projects -->
      <div id="projects-section" style="display: none;">
        <div class="section-title">
          <span>Featured Projects</span>
          <a href="/projects" style="font-size: 13px; color: var(--primary); font-weight: 600; text-decoration: none;">View All &rarr;</a>
        </div>
        <div id="projects-container" class="horizontal-scroll"></div>
      </div>
      
    </div>

    <!-- RIGHT/SIDE COLUMN -->
    <div style="display: flex; flex-direction: column; gap: var(--space-6);">
      
      <!-- Pending Actions -->
      <div class="card" style="padding: var(--space-5); border: 1px solid var(--warning); background: linear-gradient(to bottom right, var(--surface), var(--warning-bg));">
        <h3 style="font-size: 16px; font-weight: 700; color: var(--warning-dark); margin-bottom: 16px; display: flex; align-items: center; gap: 8px;">
          <i data-lucide="alert-circle" style="width: 18px;"></i> Needs Attention
        </h3>
        <div id="pending-actions">
          <div class="skeleton" style="height: 40px; margin-bottom: 8px;"></div>
          <div class="skeleton" style="height: 40px;"></div>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="card" style="padding: var(--space-5);">
        <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 16px;">Quick Actions</h3>
        <div style="display: flex; flex-direction: column; gap: 8px;">
          <% if (user.role === 'MD' || user.role === 'AM') { %>
            <a href="/associates/new" class="btn btn-secondary" style="justify-content: flex-start;"><i data-lucide="user-plus"></i> Add Associate</a>
          <% } %>
          <a href="/bookings/new" class="btn btn-secondary" style="justify-content: flex-start;"><i data-lucide="file-plus"></i> New Booking</a>
          <a href="/site-visits" class="btn btn-secondary" style="justify-content: flex-start;"><i data-lucide="map-pin"></i> Schedule Site Visit</a>
          <a href="/projects" class="btn btn-secondary" style="justify-content: flex-start;"><i data-lucide="building"></i> View Projects</a>
        </div>
      </div>

      <!-- Recent Activity -->
      <div class="card" style="padding: var(--space-5);">
        <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 16px;">Recent Activity</h3>
        <div id="recent-activity-container" style="display: flex; flex-direction: column; gap: 12px;">
          <div class="skeleton" style="height: 30px;"></div>
          <div class="skeleton" style="height: 30px;"></div>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Popup Modal -->
<div id="announcement-popup">
  <div id="announcement-modal">
    <div style="position: relative;">
      <button id="close-popup-btn" style="position: absolute; top: 12px; right: 12px; background: rgba(0,0,0,0.5); color: white; border: none; border-radius: 50%; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 10;">
        <i data-lucide="x"></i>
      </button>
      <div id="popup-image" style="height: 200px; background-size: cover; background-position: center; display: none;"></div>
      <div style="padding: 24px; text-align: center;">
        <div id="popup-badge" style="display: inline-block; padding: 4px 10px; border-radius: var(--radius-pill); font-size: 11px; font-weight: 700; margin-bottom: 12px; letter-spacing: 0.05em; text-transform: uppercase;">ANNOUNCEMENT</div>
        <h2 id="popup-title" style="font-size: 22px; font-weight: 800; margin-bottom: 12px;">Title</h2>
        <p id="popup-message" class="text-muted" style="font-size: 15px; margin-bottom: 24px; line-height: 1.5;">Message</p>
        <a id="popup-cta" href="#" class="btn btn-primary" style="display: none; margin: 0 auto; margin-bottom: 16px;">Action</a>
        
        <label style="display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 13px; color: var(--text-muted); cursor: pointer;">
          <input type="checkbox" id="popup-dismiss" style="accent-color: var(--primary);"> Don't show again
        </label>
      </div>
    </div>
  </div>
</div>

<script>
  let dashboardData = {};
  
  // Carousel Logic
  let slideIndex = 0;
  let slides = [];
  function setupCarousel(carousels) {
    if (carousels.length === 0) return;
    
    document.getElementById('hero-carousel').style.display = 'block';
    const inner = document.getElementById('carousel-inner');
    const controls = document.getElementById('carousel-controls');
    
    let html = '';
    let dotHtml = '';
    
    carousels.forEach((item, i) => {
      const activeClass = i === 0 ? 'active' : '';
      let tagHtml = item.type ? `<div class="slide-tag">${item.type}</div>` : '';
      let ctaHtml = item.ctaUrl ? `<a href="${item.ctaUrl}" class="btn" style="background: white; color: var(--brand-navy); font-weight: 700;">${item.ctaText || 'Learn More'}</a>` : '';
      
      html += `
        <div class="hero-slide ${activeClass}" id="slide-${i}" style="background-image: url('${item.image}')">
          <div class="hero-overlay">
            ${tagHtml}
            <h2 class="slide-title">${item.title || ''}</h2>
            <p class="slide-desc">${item.description || ''}</p>
            <div>${ctaHtml}</div>
          </div>
        </div>
      `;
      dotHtml += `<div class="carousel-dot ${activeClass}" id="dot-${i}" onclick="goToSlide(${i})"></div>`;
    });
    
    inner.innerHTML = html;
    controls.innerHTML = dotHtml;
    slides = carousels;
    
    if (carousels.length > 1) {
      setInterval(() => { goToSlide((slideIndex + 1) % slides.length); }, 5000);
    }
  }
  
  window.goToSlide = function(index) {
    document.getElementById(`slide-${slideIndex}`).classList.remove('active');
    document.getElementById(`dot-${slideIndex}`).classList.remove('active');
    slideIndex = index;
    document.getElementById(`slide-${slideIndex}`).classList.add('active');
    document.getElementById(`dot-${slideIndex}`).classList.add('active');
  }

  // Popup Logic
  function handlePopup(popup) {
    if (!popup || !popup.isPublished) return;
    
    // Check if dismissed in this session
    if (sessionStorage.getItem(`popup_dismissed_${popup.id}`)) {
      return;
    }
    
    showPopup(popup);
  }

  function showPopup(popup) {
    document.getElementById('popup-title').innerText = popup.title;
    document.getElementById('popup-message').innerText = popup.description;
    
    const badge = document.getElementById('popup-badge');
    badge.innerText = 'ANNOUNCEMENT';
    badge.style.background = 'var(--primary-bg)';
    badge.style.color = 'var(--primary-dark)';

    if (popup.contentType === 'image' && popup.image) {
      document.getElementById('popup-image').style.backgroundImage = `url('${popup.image}')`;
      document.getElementById('popup-image').style.display = 'block';
    } else {
      document.getElementById('popup-image').style.display = 'none';
    }
    
    const cta = document.getElementById('popup-cta');
    if (popup.ctaUrl) {
      cta.href = popup.ctaUrl;
      cta.innerText = popup.ctaText || 'View Details';
      cta.style.display = 'block';
    } else {
      cta.style.display = 'none';
    }

    const overlay = document.getElementById('announcement-popup');
    const modal = document.getElementById('announcement-modal');
    
    overlay.style.display = 'flex';
    requestAnimationFrame(() => {
      overlay.style.opacity = '1';
      modal.style.transform = 'scale(1)';
    });

    document.getElementById('close-popup-btn').onclick = () => closePopup(popup.id);
  }

  function closePopup(id) {
    const overlay = document.getElementById('announcement-popup');
    const modal = document.getElementById('announcement-modal');
    
    // Always dismiss for the session when closed
    sessionStorage.setItem(`popup_dismissed_${id}`, 'true');
    
    overlay.style.opacity = '0';
    modal.style.transform = 'scale(0.95)';
    setTimeout(() => { overlay.style.display = 'none'; }, 300);
  }

  // Load Main Data
  async function loadDashboard() {
    try {
      const res = await fetch('/api/dashboard/data');
      const data = await res.json();
      
      if (data.success) {
        dashboardData = data;
        
        // 1. KPI Cards
        const kpi = document.getElementById('kpi-container');
        let role = '<%= user.role %>';
        let kpiHtml = '';
        
        const buildCard = (title, val, icon, color, link = null) => {
          const displayVal = (val === null || val === undefined) ? '-' : val;
          const cardHtml = `
            <div class="kpi-header">
              <span class="kpi-title">${title}</span>
              <div class="kpi-icon" style="background: var(--${color}-bg); color: var(--${color});">
                <i data-lucide="${icon}"></i>
              </div>
            </div>
            <div class="kpi-value">${displayVal}</div>
          `;
          
          if (link) {
            return `<a href="${link}" class="kpi-card" style="text-decoration: none; cursor: pointer;">${cardHtml}</a>`;
          }
          return `<div class="kpi-card">${cardHtml}</div>`;
        };
        
        kpiHtml += buildCard('Total Associates', data.stats.totalAssociates, 'users', 'primary', '/team');
        kpiHtml += buildCard('Total Projects', data.stats.totalProjects, 'building', 'success', '/projects');
        kpiHtml += buildCard('Total Bookings', data.stats.totalBookings, 'file-text', 'warning', '/bookings');
        if (role === 'MD' || role === 'AM') {
          const commVal = data.stats.totalCommission !== null ? ('₹' + data.stats.totalCommission.toLocaleString('en-IN')) : null;
          kpiHtml += buildCard('Total Commission', commVal, 'indian-rupee', 'error', '/commissions');
        } else {
          kpiHtml += buildCard('Site Visits', data.stats.siteVisits, 'map-pin', 'primary', '/site-visits');
        }
        kpi.innerHTML = kpiHtml;

        // 2. Pending Actions
        const pendingContainer = document.getElementById('pending-actions');
        if (data.pendingActions.length === 0) {
          pendingContainer.innerHTML = `
            <div style="display: flex; align-items: center; gap: 8px; color: var(--success); font-weight: 600;">
              <i data-lucide="check-circle-2"></i> You're all caught up!
            </div>
            <p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">No pending actions.</p>
          `;
        } else {
          pendingContainer.innerHTML = data.pendingActions.map(a => `
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px dashed var(--border-light);">
              <span style="font-weight: 500;">${a.title}</span>
              <a href="${a.link}" class="btn btn-secondary btn-sm">Review</a>
            </div>
          `).join('');
        }

        // 3. Carousel
        setupCarousel(data.carousels);

        // 4. Offers
        if (data.offers.length > 0) {
          document.getElementById('offers-section').style.display = 'block';
          document.getElementById('offers-container').innerHTML = data.offers.map(o => `
            <div class="card" style="padding: var(--space-5); display: flex; flex-direction: column; gap: 12px; min-width: 250px;">
              <div style="background: var(--brand-gold); color: var(--brand-navy); font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 4px; align-self: flex-start; text-transform: uppercase;">${o.offerType}</div>
              <h3 style="font-size: 16px; font-weight: 700;">${o.title}</h3>
              <p style="font-size: 14px; color: var(--text-muted); flex: 1;">${o.discount || o.commissionBonus || ''}</p>
              ${o.endDate ? `<div style="font-size: 12px; color: var(--text-muted); margin-bottom: 8px;"><i data-lucide="clock" style="width: 12px;"></i> Valid till ${new Date(o.endDate).toLocaleDateString()}</div>` : ''}
              <button class="btn btn-secondary" style="width: 100%; justify-content: center;">View Offer</button>
            </div>
          `).join('');
        }

        // 5. Featured Projects
        if (data.featuredProjects && data.featuredProjects.length > 0) {
          document.getElementById('projects-section').style.display = 'block';
          document.getElementById('projects-container').innerHTML = data.featuredProjects.map(p => `
            <div class="card" style="overflow: hidden; min-width: 260px; display: flex; flex-direction: column;">
              <div style="height: 140px; background-color: var(--surface-muted); background-size: cover; background-position: center; background-image: url('${p.mediaData ? JSON.parse(p.mediaData)[0]?.url : ''}')"></div>
              <div style="padding: var(--space-4); display: flex; flex-direction: column; flex: 1; gap: 8px;">
                <h3 style="font-size: 16px; font-weight: 700; margin: 0;">${p.name}</h3>
                <p style="font-size: 13px; color: var(--text-muted); margin: 0;"><i data-lucide="map-pin" style="width: 14px;"></i> ${p.location || 'Unknown'}</p>
                <div style="margin-top: auto; display: flex; justify-content: space-between; align-items: center; padding-top: 12px; border-top: 1px solid var(--border-light);">
                  <span style="font-weight: 700; color: var(--primary);">${p.pricingData ? '₹' + JSON.parse(p.pricingData).pricePerSqYard + '/sqyd' : 'TBA'}</span>
                  <a href="/projects/${p.id}" class="btn btn-secondary btn-sm">View</a>
                </div>
              </div>
            </div>
          `).join('');
        } else {
          document.getElementById('projects-section').style.display = 'block';
          document.getElementById('projects-container').innerHTML = `
            <div class="card text-center" style="padding: 32px; width: 100%;">
              <p class="text-muted" style="margin:0;">No projects available yet.</p>
              ${(role === 'MD' || role === 'AM') ? '<a href="/projects/new" class="btn btn-primary" style="margin-top: 16px;">Add Project</a>' : ''}
            </div>
          `;
        }

        // 6. Recent Activity
        const activityContainer = document.getElementById('recent-activity-container');
        if (data.recentActivity.length === 0) {
          activityContainer.innerHTML = '<p style="font-size: 14px; color: var(--text-muted); text-align: center;">No recent activity.</p>';
        } else {
          activityContainer.innerHTML = data.recentActivity.map(act => `
            <div style="display: flex; gap: 12px; align-items: flex-start;">
              <div style="width: 8px; height: 8px; border-radius: 50%; background: var(--primary); margin-top: 6px;"></div>
              <div>
                <p style="font-size: 14px; margin: 0; font-weight: 500;">${act.text}</p>
                <p style="font-size: 12px; color: var(--text-muted); margin: 0;">${new Date(act.time).toLocaleString()}</p>
              </div>
            </div>
          `).join('');
        }

        // 7. Popups
        handlePopup(data.popup);
        
        lucide.createIcons();
      }
    } catch(e) { console.error(e); }
  }

  loadDashboard();
</script>

<%- include('../partials/footer') %>
