<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Thank You</title>
  <link rel="stylesheet" href="/css/index.css">
  <style>
    body { background: var(--bg-main); font-family: 'Inter', sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }
    .card-center { max-width: 400px; padding: var(--space-6); text-align: center; }
  </style>
</head>
<body>

<div class="card card-center">
  <div style="font-size: 48px; color: var(--success); margin-bottom: var(--space-4);">✓</div>
  <h2 style="margin-bottom: var(--space-3); color: var(--brand-navy);">Feedback Received</h2>
  <p class="text-muted">Thank you, <%= review.customerName %>! Your review has been securely submitted and locked.</p>
</div>

</body>
</html>
