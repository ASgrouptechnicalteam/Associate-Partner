<nav class="mobile-nav">
  <a href="/" class="nav-item <%= activePath === '/' ? 'active' : '' %>" style="flex-direction: column; gap: 4px; padding: 8px; margin: 0; background: transparent; color: <%= activePath === '/' ? 'var(--primary-navy)' : 'var(--text-muted)' %>;">
    <i data-lucide="layout-dashboard"></i>
    <span style="font-size: 10px;">Home</span>
  </a>
  <a href="/projects" class="nav-item <%= activePath === '/projects' ? 'active' : '' %>" style="flex-direction: column; gap: 4px; padding: 8px; margin: 0; background: transparent; color: <%= activePath === '/projects' ? 'var(--primary-navy)' : 'var(--text-muted)' %>;">
    <i data-lucide="building-2"></i>
    <span style="font-size: 10px;">Projects</span>
  </a>
  <a href="/bookings" class="nav-item <%= activePath === '/bookings' ? 'active' : '' %>" style="flex-direction: column; gap: 4px; padding: 8px; margin: 0; background: transparent; color: <%= activePath === '/bookings' ? 'var(--primary-navy)' : 'var(--text-muted)' %>;">
    <i data-lucide="file-text"></i>
    <span style="font-size: 10px;">Bookings</span>
  </a>
  <a href="/commissions" class="nav-item <%= activePath === '/commissions' ? 'active' : '' %>" style="flex-direction: column; gap: 4px; padding: 8px; margin: 0; background: transparent; color: <%= activePath === '/commissions' ? 'var(--primary-navy)' : 'var(--text-muted)' %>;">
    <i data-lucide="coins"></i>
    <span style="font-size: 10px;">Earnings</span>
  </a>
  <button id="mobile-menu-btn" class="nav-item" style="flex-direction: column; gap: 4px; padding: 8px; margin: 0; background: transparent; border: none;">
    <i data-lucide="menu"></i>
    <span style="font-size: 10px;">Menu</span>
  </button>
</nav>

<!-- Mobile Drawer Backdrop -->
<div id="mobile-drawer-backdrop" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 105; opacity: 0; transition: opacity 0.25s ease;"></div>

<!-- Mobile Drawer -->
<div id="mobile-drawer" style="position: fixed; top: 0; left: 0; bottom: 0; width: min(280px, 85vw); background: var(--surface); z-index: 110; transform: translateX(-100%); transition: transform 0.25s ease; display: flex; flex-direction: column; box-shadow: 2px 0 12px rgba(0,0,0,0.1);">
  <div style="padding: var(--space-4); border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
    <%- include('brand-logo', { width: 140 }) %>
    <button id="close-drawer-btn" style="background: transparent; border: none; padding: 4px; cursor: pointer;"><i data-lucide="x"></i></button>
  </div>
  
  <div style="flex: 1; overflow-y: auto; padding: var(--space-4); display: flex; flex-direction: column; gap: var(--space-2);">
    <!-- Secondary Nav Items -->
    <a href="/team" class="nav-item" style="padding: 12px; display: flex; align-items: center; gap: 12px; color: var(--text-primary);"><i data-lucide="users"></i> My Team</a>
    <a href="/offers" class="nav-item" style="padding: 12px; display: flex; align-items: center; gap: 12px; color: var(--text-primary);"><i data-lucide="gift"></i> Offers</a>
    <a href="/approvals" class="nav-item" style="padding: 12px; display: flex; align-items: center; gap: 12px; color: var(--text-primary);"><i data-lucide="check-square"></i> Pending Requests</a>
    <a href="/travel" class="nav-item" style="padding: 12px; display: flex; align-items: center; gap: 12px; color: var(--text-primary);"><i data-lucide="car"></i> Travel Allowance</a>
    <a href="/site-visits" class="nav-item" style="padding: 12px; display: flex; align-items: center; gap: 12px; color: var(--text-primary);"><i data-lucide="map-pin"></i> Site Visits</a>
    <a href="/profile" class="nav-item" style="padding: 12px; display: flex; align-items: center; gap: 12px; color: var(--text-primary);"><i data-lucide="user"></i> My Profile</a>
    <a href="/help" class="nav-item" style="padding: 12px; display: flex; align-items: center; gap: 12px; color: var(--text-primary);"><i data-lucide="help-circle"></i> Help Center</a>
    
    <div style="margin-top: auto; border-top: 1px solid var(--border-color); padding-top: var(--space-4);">
      <button id="drawer-install-btn" class="btn btn-secondary" style="width: 100%; justify-content: center; margin-bottom: 8px; display: none;">
        <i data-lucide="download"></i> Install App
      </button>
      <form action="/api/auth/logout" method="POST">
         <button type="submit" class="btn" style="width: 100%; justify-content: center; background: #fee2e2; color: #dc2626; border: none;">
           <i data-lucide="log-out"></i> Logout
         </button>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-drawer');
    const backdrop = document.getElementById('mobile-drawer-backdrop');
    const closeBtn = document.getElementById('close-drawer-btn');
    let isMobileMenuOpen = false;

    function openDrawer() {
      if (isMobileMenuOpen) return;
      isMobileMenuOpen = true;
      backdrop.style.display = 'block';
      // Force reflow
      void backdrop.offsetWidth;
      backdrop.style.opacity = '1';
      drawer.style.transform = 'translateX(0)';
    }

    function closeDrawer() {
      if (!isMobileMenuOpen) return;
      isMobileMenuOpen = false;
      backdrop.style.opacity = '0';
      drawer.style.transform = 'translateX(-100%)';
      setTimeout(() => {
        if (!isMobileMenuOpen) backdrop.style.display = 'none';
      }, 250);
    }

    if (mobileMenuBtn) mobileMenuBtn.addEventListener('click', openDrawer);
    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    if (backdrop) backdrop.addEventListener('click', closeDrawer);
    
    // Close on escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeDrawer();
    });
    
    // Close on navigation
    drawer.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', closeDrawer);
    });
  });
</script>
