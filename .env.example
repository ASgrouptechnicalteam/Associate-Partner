# ─────────────────────────────────────────────────────────────────────────────
# Associate Partner Portal — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file to version control.
# On Hostinger, set these via hPanel → Node.js → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── File Storage (FTP / SFTP) ─────────────────────────────────────────────────
STORAGE_SFTP_HOST=ftp.yourhostinger.com
STORAGE_SFTP_PORT=65002
STORAGE_SFTP_USER=u123456789
STORAGE_SFTP_PASSWORD=your_secure_password
STORAGE_PUBLIC_PATH=/public_html/uploads/public
STORAGE_PRIVATE_PATH=/public_html/uploads/private
STORAGE_PUBLIC_URL=https://associatepartner.sonthilluconstructions.com/uploads/public

# ── Database ──────────────────────────────────────────────────────────────────
# Hostinger MySQL connection string format:
# mysql://DB_USER:DB_PASSWORD@DB_HOST/DB_NAME
DATABASE_URL="mysql://u988844918_associate:YOUR_PASSWORD@82.25.121.145/u988844918_associate_db"

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# This is REQUIRED — the server will refuse to start without it.
JWT_SECRET="replace-with-a-long-random-secret-string"

# ── App Config ────────────────────────────────────────────────────────────────
NODE_ENV="production"

# Port the app listens on (Hostinger usually sets this automatically)
PORT=3000

# Your Hostinger domain — used for CORS and review link generation
# Include the protocol: https://yourdomain.com
ALLOWED_ORIGIN="https://yourdomain.com"

# Just the hostname, no protocol — used as fallback in review link generation
APP_DOMAIN="yourdomain.com"
